        "memberId": {
          "type": "string"
        },
        "workState": {
          "type": "string"
        },
        "gender": {
          "type": "string"
        },
        "jobTitle": {
          "type": "string"
        },
        "disabilityDueToEmployment": {
          "type": "string",
          "enum": [
            "YES",
            "NO"
          ]
        },
        "disabilityDueToAccident": {
          "type": "string",
          "enum": [
            "YES",
            "NO"
          ]
        },
        "disabilityDueToMilitaryService": {
          "type": "string",
          "enum": [
            "YES",
            "NO"
          ]
        },
